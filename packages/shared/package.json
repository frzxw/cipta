{
  "name": "@cipta/shared",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/src/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/src/index.js"
    },
    "./constants/queues": {
      "types": "./src/constants/queues.ts",
      "default": "./dist/src/constants/queues.js"
    },
    "./types/jobs": {
      "types": "./src/types/jobs.ts",
      "default": "./dist/src/types/jobs.js"
    },
    "./types/enums": {
      "types": "./src/types/enums.ts",
      "default": "./dist/src/types/enums.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "lint": "echo 'no lint configured'"
  },
  "devDependencies": {
    "@cipta/typescript-config": "workspace:*",
    "@types/node": "^25.6.0",
    "typescript": "5.9.2"
