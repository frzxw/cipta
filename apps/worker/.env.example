# Database
DATABASE_URL=postgresql://cipta:cipta_dev@localhost:5432/cipta?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_DB=0

# Worker
WORKER_CONCURRENCY_INGEST=3
WORKER_CONCURRENCY_FACTORY=2
WORKER_CONCURRENCY_GUARDIAN=5
WORKER_CONCURRENCY_FLEET=3
WORKER_TEMP_DIR=/tmp/cipta
WORKER_MAX_DOWNLOAD_SIZE_GB=10
WORKER_STALL_INTERVAL=30000

# FFmpeg
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_HW_ACCEL=auto
FFMPEG_THREADS=0
FFMPEG_DEFAULT_CRF=18
FFMPEG_DEFAULT_PRESET=medium

# yt-dlp
YTDLP_PATH=yt-dlp
YTDLP_COOKIES_PATH=
YTDLP_PROXY=
YTDLP_RATE_LIMIT=

# Cloud storage
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=
STORAGE_CDN_URL=
STORAGE_LOCAL_PATH=./storage

# AI / external APIs
WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions
WHISPER_API_KEY=CHANGE_ME
WHISPER_MODEL=whisper-1
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=CHANGE_ME
LLM_MODEL=gpt-4o
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3

# Observability
LOG_LEVEL=info
LOG_FORMAT=json
SENTRY_DSN=
SENTRY_ENVIRONMENT=development