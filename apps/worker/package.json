{
  "name": "worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@cipta/database": "workspace:^",
    "@cipta/shared": "workspace:^",
    "bullmq": "^5.75.2",
    "dotenv": "^17.4.2",
    "ioredis": "^5.10.1",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@cipta/eslint-config": "workspace:*",
    "@cipta/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
