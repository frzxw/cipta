# Core application
NODE_ENV=development
API_PORT=3001
API_HOST=0.0.0.0
API_GLOBAL_PREFIX=v1
CORS_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=postgresql://cipta:cipta_dev@localhost:5432/cipta?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_DB=0

# Authentication
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_64_CHAR_RANDOM_HEX_STRING
JWT_REFRESH_SECRET=CHANGE_ME_TO_A_DIFFERENT_64_CHAR_RANDOM_HEX_STRING
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BCRYPT_SALT_ROUNDS=12

# Cloud storage
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=
STORAGE_CDN_URL=
STORAGE_LOCAL_PATH=./storage

# FFmpeg
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_HW_ACCEL=auto
FFMPEG_THREADS=0
FFMPEG_DEFAULT_CRF=18
FFMPEG_DEFAULT_PRESET=medium

# yt-dlp
YTDLP_PATH=yt-dlp
YTDLP_COOKIES_PATH=
YTDLP_PROXY=
YTDLP_RATE_LIMIT=

# AI / external APIs
WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions
WHISPER_API_KEY=CHANGE_ME
WHISPER_MODEL=whisper-1
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=CHANGE_ME
LLM_MODEL=gpt-4o
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3

# Platform APIs
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Security
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_TO_A_32_BYTE_HEX_KEY
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100

# Observability
LOG_LEVEL=info
LOG_FORMAT=json
SENTRY_DSN=
SENTRY_ENVIRONMENT=development